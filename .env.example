# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tsetmc

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/tsetmc_scraper.log

# Scrapy Settings
CONCURRENT_REQUESTS=16
DOWNLOAD_DELAY=0.5
RETRY_TIMES=5

# Scheduler Settings
SCHEDULER_ENABLED=true
TIMEZONE=Asia/Tehran

# Trading Hours (Tehran Time)
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=0
MARKET_CLOSE_HOUR=12
MARKET_CLOSE_MINUTE=30

# Update Intervals (minutes)
MARKET_WATCH_INTERVAL=2
INSTRUMENT_DETAILS_INTERVAL=1440  # Daily
HISTORICAL_BACKFILL_INTERVAL=10080  # Weekly

# API Settings
TSETMC_BASE_URL=http://tsetmc.com/api
BRSAPI_BASE_URL=https://Api.BrsApi.ir/Tsetmc
BRSAPI_KEY=your_brsapi_key_here
REQUEST_TIMEOUT=30

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SECRET_KEY=your_secret_key_here_min_32_chars

# Monitoring
ENABLE_STATISTICS=true
ENABLE_EMAIL_ALERTS=false
ALERT_EMAIL=your-email@example.com
