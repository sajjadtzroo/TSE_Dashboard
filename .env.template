# ═════════════════════════════════════════════════════════════════════════════
# TSE Dashboard Environment Configuration
# Copy this file to .env and fill in your values
# ═════════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password-required
POSTGRES_DB=tsetmc
POSTGRES_PORT=5432
# URL-encoded Docker-internal DB URLs (use DOCKER_DATABASE_URL in docker-compose, not DATABASE_URL,
# to avoid shell env vars named DATABASE_URL overriding the Docker-internal hostname 'db').
# URL-encode any special chars in your password: ! → %21, @ → %40, # → %23, $ → %24, % → %25
DOCKER_DATABASE_URL=postgresql://postgres:change-me-url-encoded-password@db:5432/tsetmc
DOCKER_DATABASE_URL_REPLICA=postgresql://postgres:change-me-url-encoded-password@db-replica:5432/tsetmc

# ── Read Replica ─────────────────────────────────────────────────────────────
# Password for the replication user (created once on first DB init)
POSTGRES_REPLICATION_PASSWORD=change-me-strong-replication-password
# Route read-only SELECT queries here — pgbouncer-replica on port 6433
DATABASE_READ_URL=postgresql://postgres:change-me-strong-password-required@pgbouncer-replica:5432/tsetmc
DB_REPLICA_CPU_LIMIT=2.0
DB_REPLICA_MEM_LIMIT=4G
PGBOUNCER_REPLICA_POOL_SIZE=80
PGBOUNCER_REPLICA_MAX_DB_CONN=120

# ── PgBouncer ─────────────────────────────────────────────────────────────────
# DEFAULT_POOL_SIZE: server connections per (db, user) pair
# Rule: GUNICORN_WORKERS × APP_REPLICAS × SQLAlchemy_pool_size ≤ MAX_DB_CONNECTIONS ≤ max_connections (300)
# 8 workers × 1 replica × ~5 SA connections = 40 actual DB connections → pool of 120 is comfortable
PGBOUNCER_POOL_SIZE=120
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_MAX_DB_CONN=200

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@redis:6379/0
REDIS_ENABLED=true
REDIS_PORT=6379
REDIS_MAXMEMORY=2gb
REDIS_MEM_LIMIT=2G

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=8000
SERVE_STATIC=false
# For Telegram Mini App add your production domain; Telegram itself is same-origin via nginx
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Gunicorn workers ─────────────────────────────────────────────────────────
# Formula: (2 × CPU_CORES) + 1  →  4-core host = 9, capped at 8 for 3GB container
# Scale-up path: APP_REPLICAS=2, GUNICORN_WORKERS=8 → 16 total workers
GUNICORN_WORKERS=8
GUNICORN_WORKER_CONNECTIONS=1000   # max concurrent connections per worker
GUNICORN_MAX_REQUESTS=1200         # recycle worker after N requests (prevents memory leaks)
GUNICORN_MAX_REQUESTS_JITTER=100   # random spread so workers don't all recycle at once
GUNICORN_TIMEOUT=120               # seconds before killing a hung worker

# ── App container resources ──────────────────────────────────────────────────
APP_CPU_LIMIT=4.0
APP_MEM_LIMIT=3G

# ── Nginx ────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Scale-out: APP_REPLICAS=2 with GUNICORN_WORKERS=8 → 16 total workers, needs LB
APP_REPLICAS=1

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
TIMEZONE=Asia/Tehran
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=0
MARKET_CLOSE_HOUR=12
MARKET_CLOSE_MINUTE=30
MARKET_WATCH_INTERVAL=2.5

# ── MinIO Object Storage ─────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-strong-minio-password
MINIO_BUCKET=tsetmc
MINIO_SECURE=false

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-strong-grafana-password

# ── Master Seed Users (scripts/seed_master_users.py) ────────────────────────
MASTER_ADMIN_PASSWORD=change-me-strong-admin-password
MASTER_TRADER_PASSWORD=change-me-strong-trader-password

# ── API Secret ───────────────────────────────────────────────────────────────
API_SECRET_KEY=change-me-32-char-api-secret-key

# ── External API Keys (REQUIRED) ────────────────────────────────────────────
BRSAPI_KEY=your_brsapi_key_here
OPENROUTER_API_KEY=
RAG_CHAT_MODEL=google/gemini-2.0-flash-001

# ── Web Search (Tavily) ──────────────────────────────────────────────────────
# Get your key at https://tavily.com — free tier: 1,000 searches/month
TAVILY_API_KEY=your_tavily_api_key_here

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-must-be-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=60

# ── SOCKS5 Proxy ────────────────────────────────────────────────────────────
PROXY_USER=your_proxy_user
PROXY_PASS=your_proxy_pass
PROXY_HOST=your_proxy_host
PROXY_PORT=443

# ── Crypto (CoinMarketCap) ─────────────────────────────────────────────────
CMC_API_KEY=

# ── Voice Calling (direct provider WebSocket connections) ─────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
VOICE_MAX_DURATION_SECONDS=600

# ── Feature Flags ──────────────────────────────────────────────────────────
ENABLE_LOANS=true
ENABLE_CRYPTO=false
ENABLE_VOICE=false
ENABLE_TELEGRAM=false

# ── Telegram Mini App ──────────────────────────────────────────────────────
# Get from @BotFather after creating a bot. Required when ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
