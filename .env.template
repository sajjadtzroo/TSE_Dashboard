# ═════════════════════════════════════════════════════════════════════════════
# TSE Dashboard Environment Configuration
# Copy this file to .env and fill in your values
# ═════════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tsetmc
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/tsetmc

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
REDIS_PORT=6379

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=8000
# Production: set GUNICORN_WORKERS=8 and APP_REPLICAS=4 for 10K-user capacity
GUNICORN_WORKERS=4
SERVE_STATIC=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Nginx ────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Production: APP_REPLICAS=4 → 4 × 8 Gunicorn workers = 32 total workers
APP_REPLICAS=1

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
TIMEZONE=Asia/Tehran
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=0
MARKET_CLOSE_HOUR=12
MARKET_CLOSE_MINUTE=30
MARKET_WATCH_INTERVAL=2.5

# ── External API Keys (REQUIRED) ────────────────────────────────────────────
BRSAPI_KEY=your_brsapi_key_here
OPENROUTER_API_KEY=
RAG_CHAT_MODEL=google/gemini-2.0-flash-001

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-must-be-at-least-32-characters-long
JWT_EXPIRATION_MINUTES=60

# ── SOCKS5 Proxy ────────────────────────────────────────────────────────────
PROXY_USER=your_proxy_user
PROXY_PASS=your_proxy_pass
PROXY_HOST=your_proxy_host
PROXY_PORT=443

# ── Crypto (CoinMarketCap) ─────────────────────────────────────────────────
CMC_API_KEY=

# ── Voice Calling (direct provider WebSocket connections) ─────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
VOICE_MAX_DURATION_SECONDS=600

# ── Feature Flags ──────────────────────────────────────────────────────────
ENABLE_LOANS=true
ENABLE_CRYPTO=false
ENABLE_VOICE=false

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
