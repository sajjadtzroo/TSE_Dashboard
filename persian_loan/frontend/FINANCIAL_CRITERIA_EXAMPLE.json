{
  "id": "sample-car-loan",
  "nameFA": "وام خرید خودرو",
  "nameEN": "Car Purchase Loan",
  "category": "vehicle",
  "categoryFA": "خودرو",

  "minAmount": "50000000",
  "maxAmount": "500000000",
  "minAmountNumeric": 50000000,
  "maxAmountNumeric": 500000000,

  "interestRate": "18",
  "interestRateNumeric": 18,

  "repaymentPeriod": "12-60 ماه",
  "guarantor": false,

  "description": "Loan for purchasing new or used vehicles with flexible terms",
  "descriptionFA": "وام خرید خودرو نو یا کارکرده با شرایط انعطاف‌پذیر",

  "requirements": [
    "حداقل سن ۲۲ سال",
    "حداکثر سن ۶۵ سال",
    "سابقه کار ۶ ماه",
    "حداقل حقوق ۱۵ میلیون تومان"
  ],

  "financialCriteria": {
    "depositCalculation": {
      "method": "percentage",
      "methodFA": "درصدی",
      "percentage": 20,
      "coefficient": 0.20,
      "formula": "principal * 0.20",
      "formulaFA": "مبلغ اصلی × ۰.۲۰",
      "description": "20% deposit required for all car loans",
      "descriptionFA": "سپرده ۲۰٪ مبلغ وام الزامی است"
    },

    "cashFlowAnalysis": {
      "method": "npv",
      "methodFA": "ارزش فعلی خالص",
      "discountRate": 15,
      "inflationRate": 40,
      "formula": "Σ(CF_t / (1 + r)^t) - Initial Investment",
      "formulaFA": "مجموع (جریان نقدی / (۱ + نرخ تنزیل)^زمان) - سرمایه اولیه"
    },

    "interestCalculation": {
      "method": "reducing_balance",
      "methodFA": "نرخ کاهنده",
      "compoundingFrequency": "monthly",
      "compoundingFrequencyFA": "ماهانه",
      "formula": "remaining_principal * (annual_rate / 12)",
      "formulaFA": "باقیمانده اصل × (نرخ سالانه / ۱۲)",
      "effectiveRate": true
    },

    "paymentSchedule": {
      "type": "equal_installments",
      "typeFA": "اقساط مساوی",
      "formula": "P * [r(1+r)^n] / [(1+r)^n - 1]",
      "formulaFA": "اصل × [نرخ(۱+نرخ)^تعداد] / [(۱+نرخ)^تعداد - ۱]",
      "gracePeriod": 0,
      "gracePeriodFA": "بدون دوره تنفس"
    },

    "profitCalculation": {
      "method": "islamic",
      "methodFA": "روش اسلامی (مرابحه)",
      "profitRate": 18,
      "profitRateFA": "۱۸٪",
      "formula": "Cost + Agreed Profit Margin",
      "formulaFA": "قیمت تمام شده + حاشیه سود توافقی"
    },

    "feesAndCharges": {
      "processingFee": {
        "type": "percentage",
        "amount": 1,
        "formula": "principal * 0.01"
      },
      "administrativeFee": {
        "type": "fixed",
        "amount": 500000,
        "formula": "500000"
      },
      "earlyPaymentPenalty": {
        "applicable": true,
        "type": "percentage",
        "amount": 2,
        "formula": "remaining_principal * 0.02"
      },
      "latePaymentPenalty": {
        "type": "daily_interest",
        "amount": 0.1,
        "formula": "overdue_amount * 0.001 * days_late"
      }
    },

    "aprCalculation": {
      "includesFees": true,
      "includesInsurance": false,
      "formula": "((Total Paid - Principal) / Principal) / Years * 100",
      "formulaFA": "((کل پرداختی - اصل) / اصل) / سال × ۱۰۰",
      "effectiveAPR": 19.5
    },

    "amortization": {
      "method": "annuity",
      "methodFA": "آنوئیتی",
      "formula": "Standard annuity amortization schedule",
      "formulaFA": "جدول استهلاک آنوئیتی استاندارد"
    },

    "riskAssessment": {
      "debtToIncomeRatio": {
        "maximum": 0.40,
        "formula": "monthly_debt_payments / gross_monthly_income"
      },
      "loanToValueRatio": {
        "maximum": 0.80,
        "formula": "loan_amount / vehicle_value"
      },
      "creditScoreRequirement": {
        "minimum": 600,
        "methodology": "Custom scoring based on employment history, income, and existing debts"
      }
    }
  },

  "_calculations": {
    "_note": "This section shows example calculations (not part of schema)",
    "example_loan": {
