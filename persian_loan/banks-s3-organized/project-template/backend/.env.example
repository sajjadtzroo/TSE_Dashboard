# MongoDB Configuration
# Replace with your actual MongoDB URL and credentials
MONGODB_URL=mongodb://<username>:<password>@localhost:27017
DATABASE_NAME=iranian_banks

# Application
DEBUG=true

# CORS - Comma-separated list of allowed origins (DO NOT use * in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication
# IMPORTANT: Generate a secure random secret key for production!
# Use: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Cache
# Set to the Redis connection URL. Caching degrades gracefully if Redis is unavailable.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_KEY_PREFIX=ploan:cache
