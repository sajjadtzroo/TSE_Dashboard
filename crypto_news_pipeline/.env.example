# Crypto News Pipeline — Environment Variables
# Copy to project root .env and fill in your values

# Required: PostgreSQL connection (reuse your existing DATABASE_URL)
DATABASE_URL=postgresql://user:password@localhost:5432/tsetmc

# Required: MinIO (reuse your existing MinIO credentials)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=tsetmc
MINIO_SECURE=false

# CryptoPanic API (free tier: https://cryptopanic.com/developers/api/)
CRYPTOPANIC_API_KEY=

# OpenAI (only needed if NEWS_EMBEDDER=openai)
OPENAI_API_KEY=

# Pipeline settings
NEWS_EMBEDDER=openai          # "openai" or "local"
NEWS_POLL_INTERVAL_MINUTES=5
NEWS_LOG_LEVEL=INFO
